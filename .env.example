# predict-market-bot — environment variables
# Copy to .env and fill in. NEVER commit .env to git.

# ── Required ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Polymarket (primary platform) ─────────────────────────
# Your Ethereum wallet private key — generated in MetaMask
# This is the key that signs orders on-chain (Polygon network)
POLY_PRIVATE_KEY=0x...

# ── Research APIs ──────────────────────────────────────────
NEWS_API_KEY=              # newsapi.org — free tier

# ── Platform ───────────────────────────────────────────────
PLATFORMS=polymarket

# ── Bot Settings ───────────────────────────────────────────
BANKROLL=100.0             # start small — in USDC

# ── Optional: Multi-model consensus ───────────────────────
OPENAI_API_KEY=            # for GPT-4o as secondary model
GOOGLE_API_KEY=            # for Gemini as tertiary model

# ── Optional: Kalshi (US residents only) ──────────────────
KALSHI_API_KEY=
KALSHI_DEMO=true
